FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
COPY ml/requirements.txt /app/ml/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt && pip install --no-cache-dir -r /app/ml/requirements.txt
COPY backend /app/backend
COPY ml /app/ml
COPY data /app/data
WORKDIR /app/backend
RUN python -m app.seed_demo || true
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
